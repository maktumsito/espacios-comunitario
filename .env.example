# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Configuración de Servidor de Correo SMTP / Gmail / Resend:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=cristianshute@gmail.com
SMTP_PASS=
SMTP_FROM=Gestión de Espacios Diaguitas <cristianshute@gmail.com>
GMAIL_USER=cristianshute@gmail.com
GMAIL_APP_PASSWORD=
RESEND_API_KEY=

# Gmail API con renovación automática: credenciales OAuth tipo Aplicación web.
# Registrar exactamente esta URI en Google Cloud; debe usar el dominio real.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=https://DOMINIO-REAL/api/email/gmail/callback
# Opcional: clave estable para cifrar credenciales. Si está vacía se usa el client secret.
# Sin OAuth, esta clave permite recuperar la sesión temporal tras reiniciar el servidor.
GMAIL_TOKEN_ENCRYPTION_KEY=
